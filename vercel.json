{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/corporate", "destination": "/corporate.html" },
    { "source": "/destinations", "destination": "/destinations.html" },
    { "source": "/driver-onboarding", "destination": "/driver-onboarding.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/gallery", "destination": "/gallery.html" },
    { "source": "/packages", "destination": "/packages.html" },
    { "source": "/services", "destination": "/services.html" },
    { "source": "/vehicles", "destination": "/vehicles.html" },
    { "source": "/googlea9eb4b5313b9c0c3", "destination": "/googlea9eb4b5313b9c0c3.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
